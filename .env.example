# Fanspot Environment Variables
# Copy to .env.local and fill in your values

# The Odds API key (optional — if not set, falls back to ESPN projections)
ODDS_API_KEY=your-odds-api-key-here

# Scraper Docker container URL
# Used by /api/scraper endpoints to communicate with the Docker scraper
SCRAPER_URL=http://localhost:8770

# Ollama host for the concierge AI analyst
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYST_MODEL=qwen3.5:9b

# Self-hosted f1-live-api SignalR bridge (live F1 timing fallback while
# OpenF1's free tier is locked during a live session). Default shown.
F1_LIVE_API_URL=http://127.0.0.1:8791
