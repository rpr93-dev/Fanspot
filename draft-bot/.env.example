# ============ League ============
# League id from your Yahoo league URL:
#   https://football.fantasysports.yahoo.com/f1/123456/draftclient  ->  123456
YAHOO_LEAGUE_ID=123456
# Season to price players for (defaults to current year)
SEASON=2026

# ============ Pricing source ============
# What drives bid amounts:
#   fantasypros  -> expert consensus ECR ranks -> VORP dollars (default; FantasyPros
#                  publishes no public auction values, so ranks are converted to
#                  dollars with real prior-season scoring curves + your league settings)
#   fanspot      -> Fanspot's auction board (ESPN 2026 projections)
#   blend        -> average of both when both have a real price
VALUE_SOURCE=fantasypros

# ============ League settings (price the pool with Fanspot's auction engine) ============
# Per-team auction budget
BUDGET=200
# Number of teams
TEAMS=12
# Roster spots per team, including bench
ROSTER_SIZE=16
# Scoring format: ppr | half-ppr | standard
SCORING=ppr
# Starter slots: QB,RB,WR,TE,FLEX,K,D/ST as comma-separated KEY:COUNT pairs
STARTERS=QB:1,RB:2,WR:3,TE:1,FLEX:1,K:1,D/ST:1

# ============ Bot behavior (hybrid mode) ============
# Bid automatically up to this amount. If the next bid you'd make crosses it,
# the bot pauses, pings you, and waits for your call.
AUTO_BID_CAP=15
# Never spend more than this share of remaining budget on a single player
MAX_SHARE_OF_BUDGET=0.4
# On your nomination turns: nominate the top suggestion automatically (true),
# or print suggestions and wait for your input (false)
AUTO_NOMINATE=false
# Milliseconds between draft-room polls
POLL_MS=1500
# Show the browser window (false = headless). Keep true so you can watch.
HEADLESS=false
# Persistent browser profile directory — keeps you logged in between runs
USER_DATA_DIR=./profile

# ============ Yahoo identification ============
# Your team name as shown in the draft room. Lets the bot find your budget and
# roster panel. Optional but strongly recommended.
YAHOO_TEAM_NAME=

# ============ Alerts ============
# Optional: POSTed to (JSON {text: ...}) when the bot pauses for a big bid.
# Any webhook works — ntfy.sh, Slack incoming webhook, etc.
PING_URL=

# ============ Safety ============
# Log every decision but never click. Safe to run against a live room.
DRY_RUN=false
